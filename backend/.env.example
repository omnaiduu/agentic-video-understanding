DATABASE_URL=postgresql+psycopg://video:video@localhost:5432/video
DATA_DIR=../data
MAX_UPLOAD_BYTES=2147483648
BRAIN=fake
VLLM_BASE_URL=
VLLM_API_KEY=EMPTY
VLLM_MODEL=google/gemma-4-E4B-it
GEMMA_THINKING=false
VLLM_THINKING_BASE_URL=
# Default brain stays E4B. Thinking is a second E4B worker (do not put
# --reasoning-parser on agentic-video-brain):
#   modal deploy modal_brain_thinking.py
#   VLLM_THINKING_BASE_URL=https://<workspace>--agentic-video-brain-e4b-thinking-server.<region>.modal.direct/v1
# Watch checkbox / ChatIn.thinking=true routes to that URL.
# 12B A/B (closed; do not commit a flipped .env):
#   modal deploy modal_brain_12b.py
#   BRAIN=vllm
#   VLLM_BASE_URL=https://<workspace>--agentic-video-brain-12b-server.<region>.modal.direct/v1
#   VLLM_MODEL=google/gemma-4-12B-it
# L4 loads Google's official QAT checkpoint google/gemma-4-12B-it-qat-w4a16-ct
# and serves it as google/gemma-4-12B-it. Leave this default as E4B.
INGEST=fake
EMBEDDER=fake
WHISPER_MODEL=turbo
EMBED_MODEL=intfloat/e5-small-v2
VISUAL_EMBEDDER=fake
SIGLIP_MODEL=google/siglip2-so400m-patch16-384
AUDIO_EMBEDDER=fake
CLAP_MODEL=laion/larger_clap_general
SLIDE_EMBEDDER=fake
COLQWEN_MODEL=vidore/colqwen2.5-v0.2
INGEST_SECRET=
PUBLIC_BASE_URL=
MODAL_INGEST_APP=agentic-video-ingest
# Vite UI. FastAPI proxies HTML to this origin so the browser never needs :8000.
UI_ORIGIN=http://127.0.0.1:3000
# Live GPU: BRAIN=vllm, INGEST=modal, EMBEDDER=e5, VISUAL_EMBEDDER=siglip,
# AUDIO_EMBEDDER=clap, SLIDE_EMBEDDER=colqwen (query tokens go to Modal ColQwen).
# Modal idles off after 15 minutes.
